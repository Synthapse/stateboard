{
  "name": "insights",
  "private": true,
  "version": "0.1.0",
  "description": "Insights monorepo — Decide + Narrate + Prove",
  "workspaces": [
    "Prove/web",
    "packages/tf-cost"
  ],
  "scripts": {
    "dev": "npm run dev -w @stateboard/web",
    "dev:api": "dotnet run --project Prove/Stateboard.Api --urls http://localhost:5281",
    "build": "npm run build -w @stateboard/tf-cost && npm run build -w @stateboard/web",
    "test": "npm run test -w @stateboard/tf-cost",
    "test:api": "dotnet test tests/Stateboard.Tests"
  }
}
