# Copy to .env (gitignored) — never commit real keys
GEMINI_API_KEY=
XAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# Digests
# 1 = local fixture (default); 0 = load from BigQuery integrations
DIGEST_USE_FIXTURE=1
# 1 = use Gemini when GEMINI_API_KEY set; 0 = template-only
DIGEST_GENAI=1

# BigQuery integration (DIGEST_USE_FIXTURE=0)
BQ_PROJECT=cognispace
BQ_LOCATION=EU
# Optional override for all GA4 queries (else per-product ga4_location in products.py)
# BQ_GA4_LOCATION=europe-central2
# Or per product: BQ_GA4_LOCATION_KIH=EU / BQ_GA4_LOCATION_LINDLE=europe-central2
# Fail query if it would scan more than this many bytes (default 50GiB)
# BQ_MAX_BYTES_BILLED=53687091200
BQ_DATASET_INSIGHTS=marts_insights
BQ_SNAPSHOT_TABLE=snapshot_daily
BQ_STRATEGY_TABLE=product_strategy
# Optional SA JSON (else Application Default Credentials)
# BQ_CREDENTIALS_PATH=/path/to/sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# Dual-account local: Cloud SQL proxy uses ADC; BQ uses this gcloud user:
# BQ_GCLOUD_ACCOUNT=piotrzak77@gmail.com

# Delivery: email (default) | slack
DIGEST_CHANNEL=email
# Fallback if per-product unset:
DIGEST_EMAIL_TO=piotrzak77@gmail.com
# Per-product audiences (comma-separated):
# DIGEST_EMAIL_TO_KIH=piotrzak77@gmail.com
# DIGEST_EMAIL_TO_LINDLE=piotrzak77@gmail.com,team@synthapse.xyz
# DIGEST_EMAIL_TO_YCA=piotrzak77@gmail.com

# Gmail SMTP (App Password) — required to actually send email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Langfuse (EU) — API keys from Langfuse project Settings
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional per product:
# LANGFUSE_KIH_PUBLIC_KEY=
# LANGFUSE_KIH_SECRET_KEY=
# LANGFUSE_LINDLE_PUBLIC_KEY=
# LANGFUSE_LINDLE_SECRET_KEY=
# LANGFUSE_YCA_PUBLIC_KEY=
# LANGFUSE_YCA_SECRET_KEY=

# Contentsquare (UX SoT)
CONTENTSQUARE_API_KEY=
# CONTENTSQUARE_KIH_PROJECT_ID=57dec74d2513b
# CONTENTSQUARE_LINDLE_PROJECT_ID=
# CONTENTSQUARE_YCA_PROJECT_ID=

# Microsoft Clarity (legacy UX ids) — Data Export API (last 1–3 days only)
# CLARITY_API_TOKEN=
# or per product:
# CLARITY_LINDLE_PROJECT_ID=tfa09ihgyu
# CLARITY_LINDLE_API_KEY=
# CLARITY_YCA_PROJECT_ID=t9jhgsv5zv
# CLARITY_YCA_API_KEY=

# App DB extractors → core.dim_user / dim_account (never commit real URLs)
# KIH_DATABASE_URL=postgres://user:pass@host:5432/dbname
# YCA_DATABASE_URL=postgresql://user:pass@host:5432/ycadb
# LINDLE_NEO4J_URI=bolt+s://xxxx.databases.neo4j.io
# LINDLE_NEO4J_USER=neo4j
# LINDLE_NEO4J_PASSWORD=
# LINDLE_NEO4J_DATABASE=neo4j

# Healthcheck probe URL overrides (defaults in healthchecks.py)
# Optional health probe URL overrides (defaults in healthchecks.py)
# KIH uses /admin (no /health); YCA backend uses /docs; payment uses reachable mode.
# HEALTH_URL_KIH_DR_KIWI_APP=https://dr-kiwi-app-….run.app/admin
# HEALTH_URL_LINDLE_LINDLE_BACKEND=https://lindle-backend-….run.app/health
# HEALTH_URL_YCA_YCA_CA_BACKEND=https://yca-ca-backend-….run.app/docs
