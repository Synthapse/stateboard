# Copy to terraform.tfvars and fill in your Synthapse GCP project.
# Do not commit terraform.tfvars (gitignored).

project_id           = "cognispace"
region               = "europe-central2"
api_service_name     = "stateboard-api"
frontend_bucket_name = "stateboard-synthapse-frontend"
frontend_domain      = "stateboard.synthapse.xyz"
# Leave empty — europe-central2 does not support Cloud Run domain mappings.
# After apply, CNAME api.stateboard.synthapse.xyz → terraform output api_url in Cloudflare.
api_domain           = ""
gemini_secret_id     = "stateboard-gemini-api-key"

# Insights BigQuery (no Ansible — TF owns datasets/tables)
bq_location = "EU"
# GA4 datasets after BigQuery Links (Analytics & Insights Plan property IDs)
ga4_dataset_ids = [
  "analytics_499549002", # kih / Dr Kiwi
  "analytics_506154105", # lindle
  "analytics_494547928", # yca
]

# After: bash Narrate/scripts/deploy_digest_fn.sh
# digest_function_url = "https://….cloudfunctions.net/insights-digest"
# digest_function_name = "insights-digest"

