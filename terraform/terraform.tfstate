    "cloudflare_dns_hint": {
      "value": "Frontend (stateboard.synthapse.xyz):\n  Point at bucket stateboard-synthapse-frontend (same pattern as synthapse.xyz).\n\nAPI (europe-central2 — no GCP domain mapping):\n  1. Use run.app URL directly: https://stateboard-api-ukddwnxkhq-lm.a.run.app\n  2. Or in Cloudflare: CNAME api.stateboard.synthapse.xyz → host from api_url (strip https://), proxy ON.\n  Set GitHub variable STATEBOARD_API_URL or VITE_API_URL to the URL users will call (custom domain or run.app).\n\nCORS on Cloud Run must include: https://stateboard.synthapse.xyz\n",
      "type": "string"
    },
